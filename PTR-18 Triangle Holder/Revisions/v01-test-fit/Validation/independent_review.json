  "findings": [
    {
      "severity": "fit_unverified",
      "issue": "Raised webs improve clearance. At Z10 the underside is Y31.82, 66.82 mm above peg center, or 68.82 mm above the center of a nominal 20 mm hole resting on a 16 mm shaft. A 2 mm lifting allowance reduces permissible hole-center-to-top-edge offset to approximately 66.82 mm. Actual offset remains unknown."
    },
    {
      "severity": "sample_limitation",
      "issue": "Single-peg coupon verifies the complete functional peg but not the 192 mm two-peg pitch or top-edge clearance under shelf webs."
    },
    {
      "severity": "geometry_pass",
      "issue": "Hardware-hole coupon matches the 6 mm bank thickness, nominal hole diameters and horizontal print-axis orientation of the main rack. Printed clearance still requires a physical fit check."
    },
    {
      "severity": "retention",
      "issue": "Nominal 19.2 mm keeper passes through nominal 20 mm hole. 0.8 mm diametral clearance and 1.6 mm lift-to-release are geometric values, not guaranteed printed clearances or a tested load rating."
    },
    {
      "severity": "capacity",
      "issue": "40 mm open-ended fence channel and 24 mm conservative plate clearance are design capacities, not published TSO dimensions."
    },
    {
      "severity": "wall_contact",
      "issue": "17.5 mm rear cleat projection, 45 degree mating slope, and backplate contact on same wooden rail are internally consistent. Actual wall cleat thickness, height and bevel require coupon verification."
    },
    {
      "severity": "geometry_pass",
      "issue": "Both peg roots have complete 27.98 mm-diameter backing through Z0..6 despite the V notch. Nominal diameter-28 root is 0.849 mm inside the diagonal notch boundary at its closest approach. Pegs connect through diameter-30 pads to the main 4 mm backing."
    },
    {
      "severity": "strength_limit",
      "issue": "Geometry and connectivity are validated. Notched backing, split cleats, shelf webs and peg roots have not undergone calibrated mechanical analysis, material testing or long-term loaded testing."
    }
  ],
